generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Category {
  BUG
  FEATURE
  IMPROVEMENT
  SUPPORT
  OPERATIONAL
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

model Activity {
  id          String         @id @default(cuid())
  title       String
  description String
  priority    Priority
  category    Category
  team        String
  assignee    String
  status      ActivityStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([priority])
  @@index([category])
  @@index([team])
  @@index([assignee])
  @@index([status])
  @@index([updatedAt])
}
